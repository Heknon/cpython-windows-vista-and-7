diff --git a/v3.12/Python-3.12.10/Python/dynload_win.c b/v3.12/Python-3.12.10/Python/dynload_win.c
index acab05e..5c18ece 100644
--- a/v3.12/Python-3.12.10/Python/dynload_win.c
+++ b/v3.12/Python-3.12.10/Python/dynload_win.c
@@ -14,6 +14,28 @@
 #include "patchlevel.h"
 #include <windows.h>
 
+/*
+ * LOAD_LIBRARY_SEARCH_* flags were added to Vista and Windows 7 by
+ * KB2533623.  On an unpatched system LoadLibraryExW() rejects those flags
+ * with ERROR_INVALID_PARAMETER.  The module path passed by the import
+ * machinery is absolute, so LOAD_WITH_ALTERED_SEARCH_PATH is the closest
+ * pre-KB equivalent: it searches the extension module's directory before
+ * the normal DLL search locations.
+ *
+ * Only retry ERROR_INVALID_PARAMETER.  Other failures (for example a
+ * missing dependency) must be reported unchanged and must not trigger a
+ * less restrictive second search on modern Windows.
+ */
+static HMODULE
+load_library_ex_compat(const wchar_t *path, DWORD flags, DWORD legacy_flags)
+{
+    HMODULE handle = LoadLibraryExW(path, NULL, flags);
+    if (handle == NULL && GetLastError() == ERROR_INVALID_PARAMETER) {
+        handle = LoadLibraryExW(path, NULL, legacy_flags);
+    }
+    return handle;
+}
+
 #ifdef _DEBUG
 #define PYD_DEBUG_SUFFIX "_d"
 #else
