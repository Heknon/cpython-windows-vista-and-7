+{
+    HMODULE handle = LoadLibraryExW(path, NULL, flags);
+    if (handle == NULL && GetLastError() == ERROR_INVALID_PARAMETER) {
+        handle = LoadLibraryExW(path, NULL, legacy_flags);
+    }
+    return handle;
